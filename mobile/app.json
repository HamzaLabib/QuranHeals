{
  "expo": {
    "name": "Quran Heals",
    "slug": "quran-heals",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/appicon.png",
    "scheme": "quranheals",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/appicon.png",
      "bundleIdentifier": "com.quranheals.app",
      "usesAppleSignIn": true,
      "associatedDomains": ["applinks:quran-heals-api.onrender.com"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "Quran Heals connects to a local development server while testing.",
        "NSPhotoLibraryAddUsageDescription": "Quran Heals saves the ayah images you create to your photo library.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "icon": "./assets/images/appicon.png",
      "adaptiveIcon": {
        "backgroundColor": "#F7F2EA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": ["android.permission.READ_MEDIA_VISUAL_USER_SELECTED"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "quran-heals-api.onrender.com", "pathPrefix": "/ayah/" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "package": "com.quranheals.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/appicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F2EA",
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#617256"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": true
        }
      ],
      "expo-localization",
      "@react-native-community/datetimepicker",
      "./plugins/withAdvanceWidthText"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "headers": {
          "Cross-Origin-Embedder-Policy": "credentialless",
          "Cross-Origin-Opener-Policy": "same-origin"
        }
      },
      "eas": {
        "projectId": "40e37048-b7c6-471d-bb5d-de97d17ed0aa"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/40e37048-b7c6-471d-bb5d-de97d17ed0aa"
    }
  }
}
