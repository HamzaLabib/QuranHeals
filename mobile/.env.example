EXPO_PUBLIC_API_URL=http://localhost:4000

# Google OAuth client IDs (public identifiers, not secrets), one per platform.
# Leave a platform empty to hide Google sign-in there; there is no single
# shared Google client ID variable. See docs/auth-and-sync/setup.md.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Public Privacy Policy, Terms of Use and account-deletion pages (https).
# Leave empty to hide the matching Settings rows; production EAS builds
# require all three. Drafts and hosting steps: docs/legal/README.md.
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_ACCOUNT_DELETION_URL=
