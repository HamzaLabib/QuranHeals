PORT=4000
MONGODB_URI=
# Required. Development uses quranheals_dev; production uses quranheals_prod.
# Never MongoDB's default "test". See docs/backend-environments.md.
MONGODB_DB_NAME=quranheals_dev
# Set to true once this environment connects with its own scoped database
# user (readWrite on quranheals_dev only). Until then the backend only warns
# when the user can also reach another database.
MONGODB_ENFORCE_CREDENTIAL_SCOPE=
NODE_ENV=development
CORS_ORIGIN=*

# Proxy hops in front of the app (Express trust proxy); decides the client IP
# used by rate limits. Leave at 1 locally. On Render, verify the real value
# first: docs/backend-operations.md "Client IPs on Render".
TRUST_PROXY_HOPS=1
# on/off: endpoint-specific rate limits (default off; the global limit always
# applies). Production enables them only after TRUST_PROXY_HOPS is verified.
ENDPOINT_RATE_LIMITS=
# true only while verifying TRUST_PROXY_HOPS. Logs header-tagged health checks
# as address kinds + per-process hashes, never real IPs.
CLIENT_IP_DIAGNOSTICS=

# Signs/verifies this backend's own session tokens. Set a real random
# secret in production — see src/config/env.ts.
SESSION_JWT_SECRET=

# Google OAuth client ID(s) this backend accepts as the audience of a
# Google identity token. Comma-separated for more than one.
GOOGLE_CLIENT_IDS=

# Apple Services ID / bundle ID(s) this backend accepts as the audience of
# an Apple identity token. Comma-separated for more than one.
APPLE_AUDIENCE_IDS=

# --- Apple Sign-In revocation (account deletion) ---
# Only needed for server-to-server calls to Apple (authorization-code
# exchange, token revocation) — never for ordinary identity-token
# verification above. See src/auth/appleClientSecret.ts and
# src/auth/appleRevocationClient.ts.
APPLE_TEAM_ID=
APPLE_KEY_ID=
# The Sign in with Apple private key (.p8) contents, PEM format, with its
# line breaks escaped as literal \n so it fits on one line.
APPLE_PRIVATE_KEY=
# The app's bundle identifier (same value used for native Sign in with
# Apple, e.g. com.quranheals.app).
APPLE_CLIENT_ID=
# 32 random bytes, base64-encoded (e.g. `openssl rand -base64 32`) — the
# AES-256-GCM key used to encrypt a stored Apple refresh token at rest.
APPLE_REFRESH_TOKEN_ENCRYPTION_KEY=

# --- Error monitoring (Sentry), optional ---
# Leave SENTRY_DSN empty to disable (the default for local development).
# SENTRY_ENVIRONMENT defaults to NODE_ENV; SENTRY_RELEASE defaults to
# Render's RENDER_GIT_COMMIT. See docs/backend-operations.md.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

# --- Issue-report email notifications, optional ---
# off (default): reports are saved exactly as before; no email job, no email.
# log: development only. Queues and processes jobs but sends nothing (logs
#      the report id only).
# resend: sends each saved report to ISSUE_REPORT_EMAIL_TO through Resend.
# An enabled but incomplete setup stops startup; see docs/backend-operations.md.
ISSUE_REPORT_EMAIL=off
# Server-only secret. Never an EXPO_PUBLIC_ variable, never in the repo.
RESEND_API_KEY=
# "address" or "Name <address>", e.g. Quran Heals <onboarding@resend.dev>.
ISSUE_REPORT_EMAIL_FROM=
# Defaults to quranheals.support@gmail.com. Backend config only; no request can change it.
ISSUE_REPORT_EMAIL_TO=
