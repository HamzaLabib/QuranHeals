{
  "name": "quran-heals-backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "quran:restore-sources": "node scripts/restore-quran-sources.mjs",
    "seed": "tsx src/seed/seed.ts",
    "migrate:foundation": "tsx src/seed/migrateFoundation.ts",
    "mapping:upsert": "tsx src/scripts/upsertEmotionMapping.ts",
    "mapping:candidates": "tsx src/scripts/importCandidateMappings.ts",
    "mapping:activation-dry-run": "tsx src/scripts/activationDryRun.ts",
    "mapping:activate-approved": "tsx src/scripts/activateApprovedEmotionMappings.ts",
    "mapping:activate-faith-shaken": "tsx src/scripts/activateFaithShaken.ts",
    "mapping:rollback-activation": "tsx src/scripts/rollbackEmotionMappingActivation.ts",
    "mapping:consolidate-current": "tsx src/scripts/consolidateCurrentMappings.ts",
    "mapping:visibility-audit": "tsx src/scripts/mappingVisibilityAudit.ts",
    "mushaf:sync": "tsx src/scripts/mushafSync.ts",
    "validate:quran:source": "tsx src/scripts/fullQuran.ts source",
    "validate:quran": "tsx src/scripts/fullQuran.ts validate",
    "import:quran": "tsx src/scripts/fullQuran.ts import",
    "mapping:deactivate": "tsx src/scripts/deactivateEmotionMapping.ts",
    "connections:apply": "tsx src/scripts/applyAyahConnections.ts",
    "account:admin-delete": "tsx src/scripts/adminDeleteAccount.ts",
    "restore:deletions": "tsx src/scripts/restoreDeletionRegister.ts",
    "account:verify-deletion-role": "tsx src/scripts/verifyDeletionRole.ts",
    "issue-reports:retention": "tsx src/scripts/issueReportRetention.ts",
    "issue-reports:notifications": "tsx src/scripts/issueReportNotificationStatus.ts",
    "issue-reports:holds": "tsx src/scripts/issueReportHolds.ts"
  },
  "dependencies": {
    "@sentry/node": "11.7.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^11.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.1.0",
    "mongoose": "^9.11.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
