{
  "name": "quran-heals-backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx src/seed/seed.ts",
    "migrate:foundation": "tsx src/seed/migrateFoundation.ts",
    "mapping:upsert": "tsx src/scripts/upsertEmotionMapping.ts",
    "validate:quran:source": "tsx src/scripts/fullQuran.ts source",
    "validate:quran": "tsx src/scripts/fullQuran.ts validate",
    "import:quran": "tsx src/scripts/fullQuran.ts import"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.9.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
