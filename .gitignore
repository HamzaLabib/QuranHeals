# Dependencies
node_modules/
mobile/node_modules/
backend/node_modules/

# Build output
backend/dist/
mobile/.expo/
# Created only if an Expo dev server is started from backend/ by mistake (local server settings, never needed).
backend/.expo/
mobile/dist/
web-build/

# Environment files
.env
.env.*
!.env.example
*.env
*-credentials.env
credentials*.json
*.pem
*.key
*.p8
*.p12

# Downloaded Google OAuth client-secret files
client_secret*.json

# Local Quran Heals administrative files (deletion cases, audit logs, admin .env profiles; the admin tool also refuses
# paths inside this repository: backend/src/admin/localFiles.ts)
QuranHealsAdmin/

# Android signing material
*.jks
*.keystore

# iOS provisioning profiles
*.mobileprovision

# Review screenshots kept outside Git since 2026-10-15 (copies in My App/Working progress/Audit Reports/;
# the earlier commits still hold them). Ignored so the local copies are never re-added by mistake.
docs/mushaf-visual-review/
design-archive/experiments/larger-text-mushaf/screenshots/
# Its comparison images too (QCF V1 page renders, Quran Foundation content; local copies kept, untracked 2026-10-16).
design-archive/experiments/larger-text-mushaf/comparisons/*.png

# Local scratch files
tmp/
*.tmp
*.tsbuildinfo
# Python bytecode caches (written next to research scripts when they run)
__pycache__/
*.py[cod]
coverage/
.cache/
tools/quran-import/staging/

# QCF V1 page fonts (King Fahd Complex, from Quran Foundation's CDN). Their
# terms allow them only inside the app, never as a standalone download, and
# this repository is public: restored at install/build/test time by
# mobile/scripts/restore-mushaf-fonts.mjs (pinned in fonts.lock.json, which
# stays tracked). Downloaded page fonts live on devices only.
mobile/assets/mushaf/**/*.ttf
mobile/assets/mushaf/**/*.otf
mobile/assets/mushaf/**/*.woff
mobile/assets/mushaf/**/*.woff2
*.ttf.partial
*.ttf.part

# Quran Foundation Content Sync copy (mushafs:2): QF content, kept on the
# backend and relayed to the app under the Content Sync terms; never committed.
backend/data/mushaf-sync/

# The Unicode Mushaf prototype's Madina05 table and KFGQPC-derived width table once restored into the app
# (unicode-experiments/restore/restore.mjs): local only, like their archived copies (unicode-experiments/.gitignore).
mobile/src/mushaf/unicode/generated/madina05Layout.ts
mobile/src/mushaf/unicode/generated/hafsWordWidths.ts

# MongoDB pre-write snapshot backups (documented as git-ignored in
# backend/src/utils/backupPaths.ts but not previously excluded here)
backend/backups/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS/editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Third-party source/reference files kept locally
tools/quran-import/raw/UthmanicHafs_v2-0.zip
backend/data/quran/en.pickthall.txt
backend/data/quran/quran-data.xml
tools/quran-import/raw/gutenberg-16955/16955.txt
